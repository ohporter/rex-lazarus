#!/usr/bin/env python3
"""rex-lazarus: start Claude Code and Neovim again in their Rex panes after a server restart.

Rex brings back sessions, windows and panes by itself when its server starts, and each pane
keeps its block ID. It does not bring back the programs that ran in the panes. rex-lazarus
fills that gap for two programs:

  save     Record, for each pane, the Claude Code conversation or the Neovim files and
           directory in its foreground. A systemd user timer runs it every 30 seconds.
  restore  At server start, type "cd <dir> && claude --resume <id>" or
           "cd <dir> && nvim <files>" followed by Enter into each recorded pane.
           rex_lazarus.lua, which init.lua loads, runs it with --background.

State is in $REX_LAZARUS_STATE_DIR, else $XDG_STATE_HOME/rex-lazarus, else
~/.local/state/rex-lazarus.
"""

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

STATE_VERSION = 1
# The oldest Rex API revision that has every method and field rex-lazarus uses.
MIN_API_REVISION = 9
CLAUDE_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]*$")
READY_TIMEOUT = 60.0
SHELL_IDLE_TIMEOUT = 30.0
SHELL_IDLE_STABLE = 1.5


class RexError(Exception):
    """A rex CLI call failed."""


def runtime_dir() -> Path:
    return Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")


def state_dir() -> Path:
    if explicit := os.environ.get("REX_LAZARUS_STATE_DIR"):
        return Path(explicit)
    base = os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state"
    return Path(base) / "rex-lazarus"


def default_endpoint() -> str:
    return f"unix://{runtime_dir() / 'rex' / 'server.sock'}"


def log(message: str) -> None:
    """Append one line to rex-lazarus.log, and echo it when run from a terminal."""
    line = f"{datetime.now().isoformat(timespec='seconds')} {message}"
    directory = state_dir()
    directory.mkdir(parents=True, exist_ok=True)
    with (directory / "rex-lazarus.log").open("a") as f:
        f.write(line + "\n")
    if sys.stderr.isatty():
        print(line, file=sys.stderr)


class Rex:
    """The rex CLI, always aimed at one explicit server and never autostarting one."""

    def __init__(self, endpoint: str) -> None:
        self.endpoint = endpoint
        self.program = (
            os.environ.get("REX_LAZARUS_REX") or shutil.which("rex") or "/usr/bin/rex"
        )

    def run(self, *args: str, timeout: float = 10.0) -> dict:
        command = [self.program, "--autostart=false", "-S", self.endpoint, *args]
        try:
            done = subprocess.run(
                command, capture_output=True, text=True, timeout=timeout, check=False
            )
        except subprocess.TimeoutExpired as error:
            raise RexError(f"{' '.join(args)}: timed out") from error
        if done.returncode != 0:
            reason = done.stderr.strip().splitlines()
            raise RexError(f"{' '.join(args)}: {reason[0] if reason else done.returncode}")
        return json.loads(done.stdout) if done.stdout.strip() else {}

    def api(self, method: str, payload: dict | None = None) -> dict:
        args = ["api", "call", method]
        if payload is not None:
            args.append(json.dumps(payload))
        return self.run(*args)

    def block(self, block_id: str, method: str, payload: dict | None = None) -> dict:
        args = ["block", "call", "-b", block_id, method]
        if payload is not None:
            args.append(json.dumps(payload))
        return self.run(*args)

    def blocks(self) -> list[str]:
        """Every terminal block in every session."""
        found = []
        for session in self.api("session.list").get("sessions", []):
            listed = self.api("session.list_blocks", {"session_id": session["session_id"]})
            found += [
                b["block_id"]
                for b in listed.get("blocks", [])
                if b.get("creator_name") == "com.superlogical.terminal"
            ]
        return found


def load_state() -> dict:
    path = state_dir() / "state.json"
    try:
        state = json.loads(path.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return {"version": STATE_VERSION, "servers": {}}
    state.setdefault("servers", {})
    return state


def write_state(state: dict) -> None:
    directory = state_dir()
    directory.mkdir(parents=True, exist_ok=True)
    temporary = directory / "state.json.tmp"
    temporary.write_text(json.dumps(state, indent=1) + "\n")
    temporary.replace(directory / "state.json")


def cmdline(pid: int) -> list[str]:
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return []
    return [part.decode(errors="surrogateescape") for part in raw.split(b"\0") if part]


def children(pid: int) -> list[int]:
    found = []
    for task in Path(f"/proc/{pid}/task").glob("*"):
        try:
            found += [int(c) for c in (task / "children").read_text().split()]
        except OSError:
            continue
    return found


def program_of(process: dict) -> str | None:
    """Which program rex-lazarus knows runs in the foreground: "claude", "nvim" or None."""
    name = process.get("name", "")
    argv = cmdline(process["pid"])
    first = Path(argv[0]).name if argv else ""
    if name == "nvim" or first == "nvim":
        return "nvim"
    if name == "claude" or first == "claude" or "/claude/versions/" in process.get("path", ""):
        return "claude"
    # Claude Code installed with npm runs as node with the package's cli.js.
    if name == "node" and any("@anthropic-ai/claude-code" in a for a in argv[1:2]):
        return "claude"
    return None


def claude_record(process: dict) -> dict | None:
    path = Path.home() / ".claude" / "sessions" / f"{process['pid']}.json"
    try:
        session_id = json.loads(path.read_text()).get("sessionId", "")
    except (OSError, json.JSONDecodeError):
        return None
    if not CLAUDE_ID.match(session_id):
        return None
    return {"program": "claude", "cwd": process["cwd"], "session_id": session_id}


NVIM_EXPR = (
    'json_encode({"cwd": getcwd(), "cur": expand("%:p"), "bufs": map(filter('
    'getbufinfo({"buflisted": 1}), {_, b -> b.name != "" && '
    'getbufvar(b.bufnr, "&buftype") == ""}), {_, b -> b.name})})'
)


def nvim_record(process: dict) -> dict:
    """Ask the running Neovim for its directory and files; else replay its arguments."""
    # Neovim 0.10 and later listen on nvim.<pid>.0 by default. With a UI process and an
    # --embed child, the socket is the child's.
    for pid in [process["pid"], *children(process["pid"])]:
        socket = runtime_dir() / f"nvim.{pid}.0"
        if not socket.is_socket():
            continue
        try:
            done = subprocess.run(
                ["nvim", "--server", str(socket), "--remote-expr", NVIM_EXPR],
                capture_output=True, text=True, timeout=3, check=True,
            )
            info = json.loads(done.stdout)
        except (subprocess.SubprocessError, OSError, json.JSONDecodeError):
            continue
        files = [f for f in info["bufs"] if f != info["cur"]]
        if info["cur"] in info["bufs"]:
            files.insert(0, info["cur"])
        return {"program": "nvim", "cwd": info["cwd"], "files": files}
    return {"program": "nvim", "cwd": process["cwd"], "args": cmdline(process["pid"])[1:]}


def api_too_old(status: dict, command: str) -> bool:
    revision = status.get("api_revision", 0)
    if revision >= MIN_API_REVISION:
        return False
    log(f"{command}: Rex API revision {revision} is older than {MIN_API_REVISION}, stopping")
    return True


def save(rex: Rex) -> int:
    try:
        status = rex.api("server.status")
        if api_too_old(status, "save"):
            return 1
        block_ids = rex.blocks()
    except (RexError, json.JSONDecodeError) as error:
        log(f"save: server not reachable, keeping the last record ({error})")
        return 1
    state = load_state()
    server = state["servers"].get(rex.endpoint, {})
    # After a restart, the panes hold new shells until restore has run. Saving then would
    # replace the record restore needs with empty panes.
    if server.get("instance_id") not in (None, status["instance_id"]):
        log(f"save: server instance {status['instance_id']} not restored yet, skipping")
        return 0
    panes = {}
    for block_id in block_ids:
        try:
            info = rex.block(block_id, "process")
        except (RexError, json.JSONDecodeError):
            # A pane that can't answer keeps what it had.
            if block_id in server.get("panes", {}):
                panes[block_id] = server["panes"][block_id]
            continue
        foreground, child = info.get("foreground"), info.get("child")
        if not foreground or not child or foreground["pid"] == child["pid"]:
            continue
        match program_of(foreground):
            case "claude":
                record = claude_record(foreground)
            case "nvim":
                record = nvim_record(foreground)
            case _:
                record = None
        if record:
            panes[block_id] = record
    state["servers"][rex.endpoint] = {
        "instance_id": status["instance_id"],
        "saved_at": datetime.now().isoformat(timespec="seconds"),
        "panes": panes,
    }
    write_state(state)
    return 0


def resume_command(record: dict) -> str | None:
    cd = f"cd -- {shlex.quote(record['cwd'])}"
    match record:
        case {"program": "claude", "session_id": session_id} if CLAUDE_ID.match(session_id):
            return f"{cd} && claude --resume {session_id}"
        case {"program": "nvim", "files": files}:
            return f"{cd} && nvim -- {shlex.join(files)}" if files else f"{cd} && nvim"
        case {"program": "nvim", "args": args}:
            return f"{cd} && nvim {shlex.join(args)}".rstrip()
    return None


def wait_for_server(rex: Rex) -> dict | None:
    deadline = time.monotonic() + READY_TIMEOUT
    while time.monotonic() < deadline:
        try:
            return rex.api("server.status")
        except (RexError, json.JSONDecodeError):
            time.sleep(0.5)
    return None


def shell_idle(rex: Rex, block_id: str) -> bool:
    """Wait until the pane's shell has finished starting: no child, for a moment."""
    deadline = time.monotonic() + SHELL_IDLE_TIMEOUT
    idle_since = None
    while time.monotonic() < deadline:
        info = rex.block(block_id, "process")
        foreground, child = info.get("foreground"), info.get("child")
        if not child:
            return False
        if foreground and foreground["pid"] == child["pid"] and not children(child["pid"]):
            idle_since = idle_since or time.monotonic()
            if time.monotonic() - idle_since >= SHELL_IDLE_STABLE:
                return True
        else:
            idle_since = None
        time.sleep(0.25)
    return False


def restore(rex: Rex, force: bool) -> int:
    status = wait_for_server(rex)
    if status is None:
        log("restore: server not ready, giving up")
        return 1
    if api_too_old(status, "restore"):
        return 1
    if not force and status.get("config", {}).get("generation") != 1:
        log("restore: configuration reload, not a server start; nothing to do")
        return 0
    state = load_state()
    server = state["servers"].get(rex.endpoint, {})
    if not force and server.get("instance_id") == status["instance_id"]:
        log("restore: this server instance is already restored")
        return 0
    try:
        live = set(rex.blocks())
    except RexError as error:
        log(f"restore: {error}")
        return 1
    resumed, skipped, seen = [], [], set()
    for block_id, record in server.get("panes", {}).items():
        short = block_id[-6:]
        command = resume_command(record)
        if block_id not in live or command is None:
            skipped.append(f"{short} (gone)" if command else f"{short} (bad record)")
            continue
        # Two panes in one conversation would both write to it; resume the first only.
        if record["program"] == "claude":
            if record["session_id"] in seen:
                skipped.append(f"{short} (conversation resumed elsewhere)")
                continue
            seen.add(record["session_id"])
        try:
            if not shell_idle(rex, block_id):
                skipped.append(f"{short} (shell busy)")
                continue
            rex.block(block_id, "write", {"data": command + "\r"})
        except (RexError, json.JSONDecodeError) as error:
            skipped.append(f"{short} ({error})")
            continue
        resumed.append(f"{short} {record['program']}")
    # The record stays as it was until the next save, so a failed restore can be retried
    # with --force.
    server["instance_id"] = status["instance_id"]
    state["servers"][rex.endpoint] = server
    write_state(state)
    log(
        f"restore: instance {status['instance_id']}: resumed [{', '.join(resumed)}]"
        f" skipped [{', '.join(skipped)}]"
    )
    return 0


def show(rex: Rex) -> int:
    server = load_state()["servers"].get(rex.endpoint)
    if not server:
        print(f"nothing saved for {rex.endpoint}")
        return 0
    print(f"{rex.endpoint}  instance {server.get('instance_id')}  saved {server.get('saved_at')}")
    for block_id, record in server.get("panes", {}).items():
        print(f"  {block_id[-6:]}  {resume_command(record)}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="rex-lazarus", description=__doc__.split("\n")[0])
    parser.add_argument(
        "-S", "--server", default=os.environ.get("REX_LAZARUS_SERVER") or default_endpoint(),
        help="Rex server endpoint (default: %(default)s)",
    )
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("save", help="record the Claude Code and Neovim panes")
    restoring = commands.add_parser("restore", help="resume the recorded panes")
    restoring.add_argument(
        "--background", action="store_true",
        help="return at once and restore from a detached process (for init.lua)",
    )
    restoring.add_argument(
        "--force", action="store_true",
        help="restore even if this server instance was restored or started earlier",
    )
    commands.add_parser("show", help="print what restore would type into each pane")
    args = parser.parse_args()
    rex = Rex(args.server)
    match args.command:
        case "save":
            return save(rex)
        case "restore" if args.background:
            # The server can't answer until init.lua returns, so detach and return.
            command = [sys.executable, str(Path(__file__).resolve()), "-S", args.server, "restore"]
            if args.force:
                command.append("--force")
            subprocess.Popen(
                command, start_new_session=True, stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
            return 0
        case "restore":
            return restore(rex, args.force)
        case "show":
            return show(rex)
    return 2


if __name__ == "__main__":
    sys.exit(main())
